# ==============================================================================
# CONFIGURATION GLOBALE DU PIPELINE
# ==============================================================================
ENV=development
LOG_LEVEL=INFO

# ==============================================================================
# 1. BASE DE DONNÉES SOURCE A (ex: OLTP Source A)
# ==============================================================================
SOURCE_A_DB_HOST=localhost
SOURCE_A_DB_PORT=5432
SOURCE_A_DB_NAME=sourcea
SOURCE_A_DB_USER=postgres
SOURCE_A_DB_PASSWORD=HSMLdata

# ==============================================================================
# 2. BASE DE DONNÉES SOURCE B (ex: OLTP Source B)
# ==============================================================================
SOURCE_B_DB_HOST=localhost
SOURCE_B_DB_PORT=5432
SOURCE_B_DB_NAME=sourceb
SOURCE_B_DB_USER=postgres
SOURCE_B_DB_PASSWORD=HSMLdata

# ==============================================================================
# 3. DATA WAREHOUSE DE DESTINATION (ENTREPÔT - Medallion Architecture)
# ==============================================================================
DW_DB_HOST=localhost
DW_DB_PORT=5432
DW_DB_NAME=datawarehouse
DW_DB_USER=postgres
DW_DB_PASSWORD=HSMLdata

# Schémas de destination dans l'entrepôt
DW_SCHEMA_BRONZE=bronze
DW_SCHEMA_SILVER=silver
DW_SCHEMA_GOLD=gold

# ==============================================================================
# CHEMINS & STAGING (Si stockage intermédiaire nécessaire)
# ==============================================================================
LOG_PATH=./logs/